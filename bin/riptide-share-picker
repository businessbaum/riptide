#!/usr/bin/env python3
"""Screen sharing picker for xdg-desktop-portal-hyprland (its custom_picker_binary,
hypr/xdph.conf). Instead of Hyprland's own picker: the session service checks the asking
app's permission "screen" (asks the first time) and the shell shows our dialog. Prints the
choice the way the portal expects – "[SELECTION]/screen:DP-2" or "[SELECTION]/window:<id>" –
and nothing (exit 1) when nothing may be shared. No restore tokens: every share is chosen
again; the permission itself is remembered."""
import os
import sys

sys.path.insert(0, os.path.expanduser("~/.local/lib"))
from desktop_shell.sandbox import SandboxError, call_service  # noqa: E402


def windows():
    """XDPH_WINDOW_SHARING_LIST: id[HC>]class[HT>]title[HE>]address[HA>] …"""
    found = []
    for item in os.environ.get("XDPH_WINDOW_SHARING_LIST", "").split("[HA>]"):
        if "[HC>]" not in item:
            continue
        handle, rest = item.split("[HC>]", 1)
        app, rest = rest.split("[HT>]", 1)
        title = rest.split("[HE>]", 1)[0]
        found.append({"id": handle, "app": app, "title": title})
    return found


try:
    result = call_service({"call": "screen.pick", "windows": windows()}, timeout=600) or {}
except SandboxError:
    sys.exit(1)
if not result.get("selection"):
    sys.exit(1)
print(f"[SELECTION]/{result['selection']}")
