# WhatsApp Web as an app of its own: Chromium (official Arch package) in app mode – a
# window without the browser around it. No WhatsApp app exists for Linux (2026-09-29).
# A source entry: app-sandbox --sync makes the sandboxed entry the desktop uses from it.
[Desktop Entry]
Type=Application
Name=WhatsApp
GenericName=Messenger
Comment=Nachrichten mit WhatsApp Web
# The real program, not Arch's launcher /usr/bin/chromium: that one sets
# CHROME_DESKTOP=chromium.desktop over ours, and notifications came as "Chromium".
Exec=/usr/lib/chromium/chromium --app=https://web.whatsapp.com
Icon=whatsapp
# Chromium names the window after the site (--class does nothing on Wayland)
StartupWMClass=chrome-web.whatsapp.com__-Default
Terminal=false
Categories=Network;InstantMessaging;Chat;
Keywords=Chat;Messenger;Nachrichten;
StartupNotify=true
