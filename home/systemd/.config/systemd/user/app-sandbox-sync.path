# Every app starts in its sandbox, also apps installed later (docs/os-plan.md):
# when apps are installed or removed, or the list of system apps changes, their start
# entries are made anew (app-sandbox --sync).
[Unit]
Description=Keep every app starting in its sandbox

[Path]
PathChanged=/usr/share/applications
PathChanged=/usr/share/dbus-1/services
PathChanged=%h/.config/macos/sandbox.json

[Install]
WantedBy=default.target
