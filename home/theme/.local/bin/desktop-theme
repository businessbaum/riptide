#!/usr/bin/env python3
"""Generate the colour files of every app from the one theme.

    desktop-theme            use the mode from settings.json (appearance.mode)
    desktop-theme dark|light write that mode into settings.json first

Reads  ~/.config/macos/theme.json + settings.json
Writes ~/.local/state/desktop-theme/*  and tells running apps to reload.
The shell (Quickshell) runs this whenever the mode changes.

Stage 2 adds GTK 3/4, Qt (Kvantum/qt6ct) and Hyprland; for now: kitty.
"""

import json
import os
import signal
import subprocess
import sys
from pathlib import Path

HOME = Path.home()
CONFIG = HOME / ".config/macos"
STATE = HOME / ".local/state/desktop-theme"


def load(name):
    with open(CONFIG / name, encoding="utf-8") as f:
        return json.load(f)


def write(path, text):
    """Write atomically, so a reading app never sees half a file."""
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(text, encoding="utf-8")
    tmp.replace(path)


def kitty(tokens):
    t = tokens["terminal"]
    lines = [
        "# Generated by desktop-theme from ~/.config/macos/theme.json – do not edit.",
        f"background {t['background']}",
        f"foreground {t['foreground']}",
        f"cursor {t['cursor']}",
        f"selection_background {t['selection']}",
        f"selection_foreground none",
    ]
    lines += [f"color{i} {c}" for i, c in enumerate(t["palette"])]
    write(STATE / "kitty.conf", "\n".join(lines) + "\n")
    # SIGUSR1 makes kitty reload its configuration
    for pid in pids("kitty"):
        os.kill(pid, signal.SIGUSR1)


def pids(name):
    out = subprocess.run(["pidof", name], capture_output=True, text=True).stdout
    return [int(p) for p in out.split()]


def main():
    settings = load("settings.json")
    if len(sys.argv) > 1:
        mode = sys.argv[1]
        if mode not in ("dark", "light"):
            sys.exit("usage: desktop-theme [dark|light]")
        settings.setdefault("appearance", {})["mode"] = mode
        write(CONFIG / "settings.json", json.dumps(settings, indent=2, ensure_ascii=False) + "\n")
    mode = settings.get("appearance", {}).get("mode", "dark")
    theme = load("theme.json")
    tokens = theme["modes"].get(mode) or theme["modes"]["dark"]

    kitty(tokens)


if __name__ == "__main__":
    main()
