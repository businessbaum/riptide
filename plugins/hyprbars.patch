+// The title text and the button colours (focused/unfocused) are drawn into the bar,
+// but neither change requested a redraw of it, so the screen kept stale pixels there
+// until the mouse moved over the buttons.
+static void damageBarOf(PHLWINDOW window) {
+    for (auto& b : g_pGlobalState->bars) {
+        if (b && b->getOwner() == window)
+            b->damageEntire();
+    }
+}
+
+static void damageAllBars() {
+    for (auto& b : g_pGlobalState->bars) {
+        if (b)
+            b->damageEntire();
+    }
+}
