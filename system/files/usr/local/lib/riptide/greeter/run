#!/bin/sh
# Inside the login screen's Hyprland: our login window (Quickshell). Hyprland ends with it.
# A window that does not come up within 15 s (a broken greeter) is given up – then the
# start script offers the text login.
state="$XDG_RUNTIME_DIR/riptide-greeter"
qs -p /usr/local/share/riptide/greeter/shell.qml >"$state/quickshell.log" 2>&1 &
pid=$!
i=0
while [ ! -e "$state/ready" ] && kill -0 "$pid" 2>/dev/null && [ "$i" -lt 150 ]; do
    sleep 0.1
    i=$((i + 1))
done
[ -e "$state/ready" ] || kill "$pid" 2>/dev/null
wait "$pid"
hyprctl dispatch 'hl.dsp.exit()' >/dev/null
