#!/bin/sh
# greetd's greeter (/etc/greetd/config.toml), run as the user "greeter": riptide's login
# screen – Hyprland with our Quickshell login window (/usr/local/share/riptide/greeter).
# Should it not come up (or break), a text login takes its place instead of a black screen:
# agreety, which starts a shell for repairs.

# NVIDIA, as in the session (~/.config/uwsm/env)
card=$(readlink -f /dev/dri/by-path/pci-0000:01:00.0-card 2>/dev/null)
[ -n "$card" ] && export AQ_DRM_DEVICES="$card"
export LIBVA_DRIVER_NAME=nvidia __GLX_VENDOR_LIBRARY_NAME=nvidia NVD_BACKEND=direct
export XCURSOR_THEME=capitaine-cursors XCURSOR_SIZE=22 HYPRCURSOR_SIZE=22
export QT_QPA_PLATFORM=wayland LANG=de_DE.UTF-8

# No session bus: the login window needs none (greetd has its own socket, sleep and restart
# go over the system bus). Asked there, the bus started the desktop's helpers for "greeter"
# too – portals, a second sound server (registering with Bluetooth next to the user's),
# accessibility bus, file services – which cost time, and whose portal crashed with
# Hyprland at the end. Qt is told not to look for them either.
export DBUS_SESSION_BUS_ADDRESS=disabled: QT_NO_XDG_DESKTOP_PORTAL=1 QT_QPA_PLATFORMTHEME=generic

# the greeter has no home folder: everything it writes lives in its runtime folder
export HOME="$XDG_RUNTIME_DIR/home"
export XDG_CONFIG_HOME="$HOME/.config" XDG_CACHE_HOME="$HOME/.cache" XDG_DATA_HOME="$HOME/.local/share" XDG_STATE_HOME="$HOME/.local/state"
mkdir -p "$XDG_CONFIG_HOME" "$XDG_CACHE_HOME" "$XDG_DATA_HOME" "$XDG_STATE_HOME"

# the console stays black: no boot messages before, none between login screen and desktop
printf '\033c\033[?25l'

# After a logout (not a crash, not "Anderer Benutzer") the next session starts locked again,
# as at boot – its lock screen is the login window, one passage into the desktop. The
# session wrote the moment of its logout (Session.qml); greetd starts anew for its initial
# session (allowed by /etc/polkit-1/rules.d/50-riptide-greeter.rules; its runfile, which
# allows that only once per boot, is removed for this request by "relock" as root). Once
# per logout, never in a loop: a session that ends at once leaves this login screen here.
auto=$(sed -n '/^\[initial_session\]/,/^\[/s/^user *= *"\(.*\)"/\1/p' /etc/greetd/config.toml)
if [ -n "$auto" ]; then
    out=$(cat "/var/lib/riptide/greeter/users/$auto/logged-out" 2>/dev/null)
    done=$(cat /var/lib/riptide/greeter/autologin-done 2>/dev/null)
    case "$out" in '' | *[!0-9]*) out=0 ;; esac
    case "$done" in '' | *[!0-9]*) done=0 ;; esac
    if [ "$out" -gt "$done" ] && [ $(($(date +%s) - out)) -lt 120 ]; then
        echo "$out" > /var/lib/riptide/greeter/autologin-done
        systemctl --no-block restart greetd.service && exec sleep 30
    fi
fi

state="$XDG_RUNTIME_DIR/riptide-greeter"
rm -rf "$state"
mkdir -p "$state"

Hyprland --config /usr/local/share/riptide/greeter/hyprland.lua >"$state/hyprland.log" 2>&1

# logged in: greetd starts the session now
if [ -e "$state/launched" ]; then
    printf '\033c\033[?25l'
    exit 0
fi

# the text login: the console back to text first – a Hyprland that crashed on its way out
# can leave it in graphics mode, and the login would be invisible (KDSETMODE, KD_TEXT)
python3 -c 'import fcntl; fcntl.ioctl(0, 0x4B3A, 0)' 2>/dev/null
printf '\033c\033[?25h'
exec agreety --cmd "/bin/bash --login"
