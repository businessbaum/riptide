#!/usr/bin/env bash
# The only part of the desktop that runs as root, through pkexec (docs/os-plan.md,
# "Architecture"). Every area has its own polkit action (org.riptide.helper.<area>), every
# action and argument is checked; nothing else is possible through this script.
#
#   riptide-helper packages install <package>…   install from the official repos (core, extra, multilib)
#   riptide-helper packages remove <package>     remove an explicitly installed app (and its unused deps)
#   riptide-helper packages upgrade              update the whole system (pacman -Syu)
#   riptide-helper packages clean-cache          keep only the newest package version in the cache
set -euo pipefail
export LC_ALL=C.UTF-8 LANG=C.UTF-8
PATH=/usr/bin

die() { echo "FEHLER: $*" >&2; exit 1; }

# ------------------------------------------------------------------ packages

OFFICIAL='^(core|extra|multilib)$'

protected() { # is the package part of the system? (list: /usr/local/share/riptide/protected-packages)
    local pattern
    while read -r pattern; do
        [[ -z "$pattern" || "$pattern" == \#* ]] && continue
        [[ "$1" =~ ^($pattern)$ ]] && return 0
    done < /usr/local/share/riptide/protected-packages
    return 1
}

valid_name() { [[ "$1" =~ ^[a-z0-9@._+][a-z0-9@._+-]*$ ]]; }

repo_of() { # repository a package would come from, empty if none
    pacman -Si -- "$1" 2>/dev/null | awk -F': *' '/^Repository/ {print $2; exit}'
}

packages() {
    [[ $# -ge 1 ]] || die "keine Aktion"
    local action=$1 p
    shift
    case "$action" in
    install)
        [[ $# -ge 1 ]] || die "kein Paket angegeben"
        for p in "$@"; do
            valid_name "$p" || die "ungültiger Paketname: $p"
            [[ "$(repo_of "$p")" =~ $OFFICIAL ]] || die "$p ist nicht in den offiziellen Paketquellen"
        done
        exec pacman -S --needed --noconfirm -- "$@"
        ;;
    remove)
        [[ $# -eq 1 ]] || die "genau ein Paket angeben"
        p=$1
        valid_name "$p" || die "ungültiger Paketname: $p"
        protected "$p" && die "$p gehört zum System und wird hier nicht entfernt"
        pacman -Qqe -- "$p" >/dev/null 2>&1 || die "$p ist nicht als App installiert"
        exec pacman -Rns --noconfirm -- "$p"
        ;;
    upgrade)
        [[ $# -eq 0 ]] || die "upgrade nimmt keine Pakete"
        exec pacman -Syu --noconfirm
        ;;
    clean-cache)
        [[ $# -eq 0 ]] || die "clean-cache nimmt keine Pakete"
        # newest version of installed packages stays (for a quick downgrade), the rest goes
        paccache -rk1
        exec paccache -ruk0
        ;;
    *)
        die "unbekannte Aktion: packages $action"
        ;;
    esac
}

# ------------------------------------------------------------------ dispatch

[[ $# -ge 1 ]] || die "kein Bereich"
area=$1
shift
case "$area" in
packages) packages "$@" ;;
*) die "unbekannter Bereich: $area" ;;
esac
